    <string name="label_distance">한 번에 넘기는 거리</string>
    <string name="label_interval">쉬는 시간 — 다음 동작까지</string>
    <string name="label_total">전체 실행 시간</string>
    <string name="label_delay">시작 준비 시간</string>
