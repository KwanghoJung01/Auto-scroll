<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">자동 스크롤</string>
    <string name="app_tagline">보상 앱을 보는 동안 손가락 대신 화면을 천천히 쓸어내립니다.</string>

    <string name="accessibility_label">자동 스크롤</string>
    <string name="accessibility_description">화면을 대신 쓸어내리기 위해 접근성 제스처 권한이 필요합니다. 화면 내용을 읽거나 저장하지 않습니다.</string>
    <string name="accessibility_summary">설정한 속도와 시간에 맞춰 자동으로 스크롤합니다.</string>

    <string name="section_permission">1. 준비하기</string>
    <string name="permission_accessibility">접근성 서비스</string>
    <string name="permission_accessibility_hint">설정 → 접근성 → 설치된 앱 → 자동 스크롤 을 켜주세요.</string>
    <string name="permission_overlay">다른 앱 위에 표시</string>
    <string name="permission_overlay_hint">보상 앱 위에 작은 조작 바를 띄우기 위해 필요합니다.</string>
    <string name="permission_granted">허용됨</string>
    <string name="permission_missing">허용 필요</string>

